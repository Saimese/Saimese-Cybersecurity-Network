---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Cybersecurity News" description="Latest cybersecurity news, analysis, and insights">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-cyber-accent mb-4">Cybersecurity News</h1>
      <p class="text-gray-400 text-lg">
        Stay updated with the latest in cybersecurity, threat intelligence, and industry news.
      </p>
    </div>

    <div class="space-y-6">
      {news.map((article) => (
        <a 
          href={`${base}news/${article.slug}/`}
          class="block bg-cyber-dark rounded-lg border border-cyber-accent/20 p-6 hover:border-cyber-accent/50 transition transform hover:translate-x-2"
        >
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
            <div class="flex-1">
              <h2 class="text-2xl font-bold text-white mb-2">{article.data.title}</h2>
              <p class="text-gray-400 mb-4">{article.data.summary}</p>
              
              <div class="flex flex-wrap items-center gap-4">
                <div class="flex flex-wrap gap-2">
                  {article.data.tags.map((tag: string) => (
                    <span class="px-2 py-1 bg-cyber-purple/10 text-cyber-purple text-xs rounded font-mono">
                      #{tag}
                    </span>
                  ))}
                </div>
                
                {article.data.author && (
                  <span class="text-gray-500 text-sm">
                    By {article.data.author}
                  </span>
                )}
              </div>
            </div>
            
            <div class="text-gray-500 text-sm md:text-right whitespace-nowrap">
              {article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
          </div>
        </a>
      ))}
    </div>

    {news.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-400 text-lg">No news articles yet. Check back soon!</p>
      </div>
    )}
  </div>
</BaseLayout>
