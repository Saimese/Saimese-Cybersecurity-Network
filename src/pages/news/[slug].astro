---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
---

<BaseLayout title={article.data.title} description={article.data.summary}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <header class="mb-8">
      <div class="flex items-center gap-4 mb-4 text-sm text-gray-500">
        <span>
          {article.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </span>
        {article.data.author && (
          <>
            <span>•</span>
            <span>By {article.data.author}</span>
          </>
        )}
      </div>

      <h1 class="text-4xl md:text-5xl font-bold text-cyber-accent mb-4">
        {article.data.title}
      </h1>

      <p class="text-gray-400 text-lg mb-4">{article.data.summary}</p>

      <div class="flex flex-wrap gap-2">
        {article.data.tags.map((tag: string) => (
          <span class="px-3 py-1 bg-cyber-purple/10 text-cyber-purple text-sm rounded font-mono">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Content -->
    <div class="prose prose-invert max-w-none bg-cyber-dark/50 rounded-lg p-8 border border-cyber-accent/20">
      <Content />
    </div>

    <!-- Comments (Giscus, one thread per news URL) -->
    <section class="mt-10">
      <Giscus />
    </section>
  </article>
</BaseLayout>
