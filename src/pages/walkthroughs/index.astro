---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const walkthroughs = (await getCollection('walkthroughs'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="TryHackMe Walkthroughs" description="Detailed TryHackMe room walkthroughs and solutions">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-cyber-accent mb-4">TryHackMe Walkthroughs</h1>
      <p class="text-gray-400 text-lg">
        Step-by-step guides for TryHackMe rooms. Learn, practice, and level up your cybersecurity skills.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {walkthroughs.map((walkthrough) => (
        <a 
          href={`/walkthroughs/${walkthrough.slug}`}
          class="block bg-cyber-dark rounded-lg border border-cyber-accent/20 p-6 hover:border-cyber-accent/50 transition transform hover:scale-105"
        >
          <div class="flex items-center justify-between mb-4">
            <span class={`px-3 py-1 rounded-full text-xs font-semibold ${
              walkthrough.data.difficulty === 'Easy' ? 'bg-green-500/20 text-green-400' :
              walkthrough.data.difficulty === 'Medium' ? 'bg-yellow-500/20 text-yellow-400' :
              'bg-red-500/20 text-red-400'
            }`}>
              {walkthrough.data.difficulty}
            </span>
            <span class="text-gray-500 text-xs">
              {walkthrough.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
          </div>
          
          <h2 class="text-xl font-bold text-white mb-3">{walkthrough.data.title}</h2>
          
          {walkthrough.data.description && (
            <p class="text-gray-400 text-sm mb-4">{walkthrough.data.description}</p>
          )}
          
          <div class="flex flex-wrap gap-2">
            {walkthrough.data.tags.map((tag: string) => (
              <span class="px-2 py-1 bg-cyber-accent/10 text-cyber-accent text-xs rounded font-mono">
                #{tag}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>

    {walkthroughs.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-400 text-lg">No walkthroughs yet. Check back soon!</p>
      </div>
    )}
  </div>
</BaseLayout>
