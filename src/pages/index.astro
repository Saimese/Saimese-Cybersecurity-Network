---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const recentWalkthroughs = (await getCollection('walkthroughs'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const recentNews = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-cyber-dark via-cyber-darker to-cyber-dark py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">
          <span class="text-white">Saimese</span>
          <span class="text-cyber-accent"> Cybersecurity</span>
          <span class="text-white"> Network</span>
        </h1>
        <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
          Your trusted resource for TryHackMe walkthroughs, cybersecurity news, and ethical hacking education.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href={`${base}/walkthroughs`}
            class="px-8 py-3 bg-cyber-accent text-cyber-darker font-semibold rounded-lg hover:bg-cyber-green transition transform hover:scale-105"
          >
            Browse Walkthroughs
          </a>
          <a 
            href={`${base}/news`}
            class="px-8 py-3 bg-cyber-blue text-white font-semibold rounded-lg hover:bg-blue-700 transition transform hover:scale-105"
          >
            Read Latest News
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-16 bg-cyber-dark/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center p-6 bg-cyber-dark rounded-lg border border-cyber-accent/20">
          <div class="text-4xl mb-4">🎯</div>
          <h3 class="text-xl font-bold text-cyber-accent mb-2">Education</h3>
          <p class="text-gray-400">Comprehensive walkthroughs and guides to help you master cybersecurity skills.</p>
        </div>
        <div class="text-center p-6 bg-cyber-dark rounded-lg border border-cyber-accent/20">
          <div class="text-4xl mb-4">🤝</div>
          <h3 class="text-xl font-bold text-cyber-accent mb-2">Community</h3>
          <p class="text-gray-400">Join discussions, share knowledge, and grow together with fellow security enthusiasts.</p>
        </div>
        <div class="text-center p-6 bg-cyber-dark rounded-lg border border-cyber-accent/20">
          <div class="text-4xl mb-4">⚖️</div>
          <h3 class="text-xl font-bold text-cyber-accent mb-2">Ethics</h3>
          <p class="text-gray-400">Promoting responsible disclosure and ethical hacking practices.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Walkthroughs -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-cyber-accent mb-8">Recent Walkthroughs</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {recentWalkthroughs.map((walkthrough) => (
          <a 
            href={`${base}/walkthroughs/${walkthrough.slug}`}
            class="block bg-cyber-dark rounded-lg border border-cyber-accent/20 p-6 hover:border-cyber-accent/50 transition transform hover:scale-105"
          >
            <div class="flex items-center justify-between mb-3">
              <span class={`px-3 py-1 rounded-full text-xs font-semibold ${
                walkthrough.data.difficulty === 'Easy' ? 'bg-green-500/20 text-green-400' :
                walkthrough.data.difficulty === 'Medium' ? 'bg-yellow-500/20 text-yellow-400' :
                'bg-red-500/20 text-red-400'
              }`}>
                {walkthrough.data.difficulty}
              </span>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{walkthrough.data.title}</h3>
            <p class="text-gray-400 text-sm mb-4">{walkthrough.data.description || 'TryHackMe room walkthrough'}</p>
            <div class="flex flex-wrap gap-2">
              {walkthrough.data.tags.map((tag: string) => (
                <span class="px-2 py-1 bg-cyber-accent/10 text-cyber-accent text-xs rounded">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href={`${base}/walkthroughs`} class="text-cyber-accent hover:text-cyber-green font-semibold">
          View All Walkthroughs →
        </a>
      </div>
    </div>
  </section>

  <!-- Recent News -->
  <section class="py-16 bg-cyber-dark/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-cyber-accent mb-8">Latest News</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {recentNews.map((article) => (
          <a 
            href={`${base}/news/${article.slug}`}
            class="block bg-cyber-dark rounded-lg border border-cyber-accent/20 p-6 hover:border-cyber-accent/50 transition transform hover:scale-105"
          >
            <h3 class="text-xl font-bold text-white mb-2">{article.data.title}</h3>
            <p class="text-gray-400 text-sm mb-4">{article.data.summary}</p>
            <div class="flex flex-wrap gap-2 mb-3">
              {article.data.tags.map((tag: string) => (
                <span class="px-2 py-1 bg-cyber-purple/10 text-cyber-purple text-xs rounded">
                  {tag}
                </span>
              ))}
            </div>
            <p class="text-gray-500 text-xs">
              {article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href={`${base}/news`} class="text-cyber-accent hover:text-cyber-green font-semibold">
          View All News →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
