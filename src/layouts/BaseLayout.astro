---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Saimese Cybersecurity Network - TryHackMe Walkthroughs and Cybersecurity News" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title} | Saimese Cybersecurity Network</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body class="bg-cyber-darker text-gray-100 min-h-screen flex flex-col">
  <Navigation />
  <main class="flex-grow">
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: system-ui, -apple-system, sans-serif;
  }

  code, pre {
    font-family: 'JetBrains Mono', monospace;
  }

  /* Markdown content styling */
  .prose {
    max-width: 100%;
  }

  .prose h1, .prose h2, .prose h3 {
    color: #00ff88;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .prose pre {
    background: #1a1a2e !important;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
    border: 1px solid #00ff8844;
  }

  .prose code {
    background: #1a1a2e;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
    color: #00ff88;
  }

  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .prose ul, .prose ol {
    margin-left: 2rem;
    margin-bottom: 1rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose a {
    color: #00ff88;
    text-decoration: underline;
  }

  .prose a:hover {
    color: #10b981;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  .prose blockquote {
    border-left: 4px solid #00ff88;
    padding-left: 1rem;
    margin: 1rem 0;
    color: #9ca3af;
    font-style: italic;
  }
</style>
<script src="https://giscus.app/client.js"
        data-repo="Saimese/saimese-cybersecurity-network"
        data-repo-id="R_kgDOQPMbGA"
        data-category="Q&A"
        data-category-id="DIC_kwDOQPMbGM4C1dKg"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="en"
        crossorigin="anonymous"
        async>
</script>
