---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<nav class="bg-cyber-dark border-b border-cyber-accent/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center">
        <a href={base} class="text-cyber-accent font-bold text-xl font-mono">
          <span class="text-white">[</span>SCN<span class="text-white">]</span>
        </a>
      </div>
      <div class="flex space-x-8">
        <a 
          href={base} 
          class={`px-3 py-2 rounded-md text-sm font-medium transition ${
            currentPath === base || currentPath === `${base}/`
              ? 'bg-cyber-accent/10 text-cyber-accent' 
              : 'text-gray-300 hover:bg-cyber-blue/10 hover:text-white'
          }`}
        >
          Home
        </a>
        <a 
          href={`${base}/walkthroughs`}
          class={`px-3 py-2 rounded-md text-sm font-medium transition ${
            currentPath.startsWith(`${base}/walkthroughs`) 
              ? 'bg-cyber-accent/10 text-cyber-accent' 
              : 'text-gray-300 hover:bg-cyber-blue/10 hover:text-white'
          }`}
        >
          Walkthroughs
        </a>
        <a 
          href={`${base}/news`}
          class={`px-3 py-2 rounded-md text-sm font-medium transition ${
            currentPath.startsWith(`${base}/news`) 
              ? 'bg-cyber-accent/10 text-cyber-accent' 
              : 'text-gray-300 hover:bg-cyber-blue/10 hover:text-white'
          }`}
        >
          News
        </a>
      </div>
    </div>
  </div>
</nav>
