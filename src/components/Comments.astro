---
// Giscus comment component
// Configure these values in your GitHub repo
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="giscus-container mt-12 pt-8 border-t border-cyber-accent/20">
  <h3 class="text-2xl font-bold text-cyber-accent mb-4">Comments</h3>
  <script 
    src="https://giscus.app/client.js"
    data-repo="YOUR_USERNAME/saimese-cybersecurity-network"
    data-repo-id="YOUR_REPO_ID"
    data-category="General"
    data-category-id="YOUR_CATEGORY_ID"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="dark"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async>
  </script>
</div>

<style>
  .giscus-container {
    background: rgba(30, 58, 138, 0.1);
    padding: 2rem;
    border-radius: 0.5rem;
  }
</style>

<!-- 
SETUP INSTRUCTIONS:
1. Go to https://giscus.app/
2. Enter your repository: YOUR_USERNAME/saimese-cybersecurity-network
3. Enable GitHub Discussions in your repo settings
4. Copy the generated script tag values
5. Replace the placeholder values above:
   - data-repo
   - data-repo-id
   - data-category-id
-->
