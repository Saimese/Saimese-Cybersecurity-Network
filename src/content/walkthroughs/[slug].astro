// src/pages/walkthroughs/[slug].astro
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import Giscus from '../../components/Giscus.astro';

export async function getStaticPaths() {
  const walkthroughs = await getCollection('walkthroughs');
  return walkthroughs.map((entry) => ({
    params: { slug: entry.slug },   // "capa-the-basics" from capa-the-basics.md
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, data } = await entry.render();
---

<BaseLayout title={data.title}>
  <article>
    <h1>{data.title}</h1>
    <Content />
  </article>

  <Giscus />   {/* comments only on individual walkthrough pages */}
</BaseLayout>
